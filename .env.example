# Copy to .env.local and fill in. A blank value counts as unset -- setting a
# variable to "" will not satisfy the requirement, and on Vercel that is the
# usual cause of a failed deploy.
#
# Validated by src/lib/env.ts on first use.

# --- Required ---------------------------------------------------------------

# MongoDB Atlas connection string. Include the database name in the path
# (".../pact?...") or you will silently connect to "test".
MONGODB_URI="mongodb+srv://user:password@cluster.mongodb.net/pact?retryWrites=true&w=majority"

# Signs the session JWT. Generate with: openssl rand -base64 32
# Rotating this invalidates every existing session.
AUTH_SECRET=""

# AUTH_URL is intentionally absent. Auth.js derives the origin from the request,
# which is what keeps preview deployments working. Setting it pins every
# redirect to one host. Only set it when running behind a proxy that does not
# send forwarded headers. See docs/decisions.md, 008.

# Shared secret Vercel Cron presents on scheduled invocations.
CRON_SECRET=""

# --- Optional ---------------------------------------------------------------

# IANA timezone for rendering. Storage is always UTC. Default: Asia/Kolkata
APP_TIMEZONE="Asia/Kolkata"

# Read only by `npm run seed:user`, never by the running app.
#
# SEED_USER_PASSWORD is deliberately NOT listed here. The script ignores any
# value found in a dotenv file, because dotenv expansion silently rewrites
# anything containing $, ${...} or # -- and a mangled password produces an
# account you cannot sign in to, with no error anywhere. Supply it in the shell
# for one command, or let the script generate one and print it once:
#
#   SEED_USER_PASSWORD='...' npm run seed:user
#   npm run seed:user
SEED_USER_EMAIL=""
# Optional display name; defaults to the part of the email before the "@".
SEED_USER_NAME=""
