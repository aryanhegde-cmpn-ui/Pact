# Copy to .env.local and fill in. Every variable here is required except where a
# default is noted -- src/lib/schemas/env.ts validates them at module load and
# refuses to start if any are missing.

# MongoDB Atlas connection string (M0 free tier is fine).
MONGODB_URI="mongodb+srv://user:password@cluster.mongodb.net/pact?retryWrites=true&w=majority"

# NextAuth. Generate the secret with: openssl rand -base64 32
NEXTAUTH_SECRET=""
NEXTAUTH_URL="http://localhost:3000"

# Google OAuth client (Google Cloud Console > APIs & Services > Credentials).
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# The single Google account permitted to sign in. This is a one-user app.
ALLOWED_EMAIL=""

# Bearer token the smart-mirror device presents to read /mirror without a session.
MIRROR_DEVICE_TOKEN=""

# Shared secret Vercel Cron presents on scheduled invocations.
CRON_SECRET=""

# IANA timezone used for all rendering. Storage is always UTC. Default: Asia/Kolkata
APP_TIMEZONE="Asia/Kolkata"
