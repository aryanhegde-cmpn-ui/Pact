{
  "name": "pact",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": "22.x"
  },
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "dev:no-open": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "seed:user": "NODE_OPTIONS=--conditions=react-server tsx scripts/seed-user.ts",
    "change:password": "NODE_OPTIONS=--conditions=react-server tsx scripts/change-password.ts",
    "seed:history": "NODE_OPTIONS=--conditions=react-server tsx scripts/seed-history.ts"
  },
  "dependencies": {
    "@node-rs/argon2": "^2.2.0",
    "@tanstack/react-query": "^5.102.8",
    "mongoose": "^9.9.4",
    "next": "^16.3.4",
    "next-auth": "^5.0.0-beta.32",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "server-only": "^0.0.1",
    "zod": "^4.5.4"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "^20.19.9",
    "@types/react": "^19.2.2",
    "@types/react-dom": "^19.2.2",
    "eslint": "^9.39.0",
    "eslint-config-next": "^16.3.4",
    "eslint-config-prettier": "^10.1.8",
    "prettier": "^3.6.2",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.13",
    "typescript": "^5.9.3",
    "vitest": "^4.1.11"
  }
}
